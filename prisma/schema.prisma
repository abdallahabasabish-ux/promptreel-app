generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  name               String
  role               String    @default("user") // user | admin
  status             String    @default("active") // active | banned
  emailVerifiedAt    DateTime?
  googleId           String?   @unique
  theme              String    @default("system") // system | light | dark
  defaultSceneCount  Int       @default(6)
  defaultLanguageCode String   @default("en")
  planId             String?
  planPeriodEnd      DateTime?
  stripeCustomerId   String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plan     Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  sessions Session[]
  projects Project[]
  videos   ReferenceVideo[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  type      String // verify_email | reset_password
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, type])
}

model Plan {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  description        String   @default("")
  priceCents         Int      @default(0)
  currency           String   @default("usd")
  monthlyGenerations Int      @default(10) // -1 = unlimited
  maxVideoMb         Int      @default(50)
  features           String   @default("[]") // JSON array of strings
  isActive           Boolean  @default(true)
  isDefault          Boolean  @default(false)
  stripeEnvNote      String   @default("")
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]

  @@index([isActive])
}

model PromptLanguage {
  id         String  @id @default(cuid())
  name       String // English display name, e.g. "English"
  nativeName String  // e.g. "English", "العربية"
  code       String  @unique // e.g. en, ar, fr
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)
}

model Project {
  id           String    @id @default(cuid())
  userId       String
  title        String
  idea         String
  sceneCount   Int
  languageCode String
  languageName String
  status       String    @default("queued") // queued | running | succeeded | failed
  progress     Int       @default(0) // 0-100
  statusMessage String   @default("")
  modelUsed    String?
  error        String?
  shareToken   String?   @unique
  shareEnabled Boolean   @default(false)
  hasVideo     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes Scene[]
  video  ReferenceVideo?

  @@index([userId, createdAt])
  @@index([status])
}

model Scene {
  id           String  @id @default(cuid())
  projectId    String
  idx          Int
  title        String
  durationSec  Int
  imagePrompt  String
  videoPrompt  String
  dialogue     String?
  camera       String?
  transition   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, idx])
}

model ReferenceVideo {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?   @unique
  filename      String
  storedPath    String
  mimeType      String
  sizeBytes     Int
  durationHint  Float?
  geminiFileUri String?
  geminiFileName String?
  geminiState   String?
  createdAt     DateTime  @default(now())
  cleanedAt     DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model GeminiKey {
  id            String    @id @default(cuid())
  label         String
  key           String
  isActive      Boolean   @default(true)
  lastStatus    String? // ok | invalid | unknown
  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
}

model AppSetting {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PaymentEvent {
  id          String   @id // Stripe event id (idempotency)
  type        String
  payload     String
  processedAt DateTime @default(now())
}
